<?xml version="1.0"?>
<package format="3">
  <name>fr5_rviz_sync</name>
  <version>0.1.0</version>
  <description>Read-only live FR5 joint feedback to RViz. No motion commands.</description>
  <maintainer email="dj306@example.com">dj306</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>fairino_msgs</exec_depend>
  <exec_depend>fairino_description</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
