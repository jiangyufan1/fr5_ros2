# Default text detection
* text=auto

# C++ and Python
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.py text eol=lf

# Shell and build
*.sh text eol=lf
*.bash text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# ROS 2 configuration
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.urdf text eol=lf
*.xacro text eol=lf
*.srdf text eol=lf
*.msg text eol=lf
*.srv text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary assets
*.STL binary
*.stl binary
*.so binary
*.so.* binary
*.a binary
*.zip binary
*.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
